@@ -88,6 +88,20 @@ namespace dxvk {
     return D3D_OK;
   }

+  HRESULT DxvkD3D8Bridge::CreateEffectShader(BOOL vertex, const DWORD* function, void** shader) {
+    if (vertex) {
+      IDirect3DVertexShader9* result = nullptr;
+      HRESULT status = m_device->CreateVertexShaderInternal(function, &result, true);
+      *shader = result;
+      return status;
+    }
+
+    IDirect3DPixelShader9* result = nullptr;
+    HRESULT status = m_device->CreatePixelShaderInternal(function, &result, true);
+    *shader = result;
+    return status;
+  }
+
   DxvkD3D8InterfaceBridge::DxvkD3D8InterfaceBridge(D3D9InterfaceEx* pObject)
     : m_interface(pObject) {
   }
